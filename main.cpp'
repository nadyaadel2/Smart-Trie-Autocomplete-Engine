#include <iostream>
#include "Trie.h"
using namespace std;

int main() {
    Trie myTrie;

    myTrie.insert("google");
    myTrie.insert("github");
    myTrie.insert("graph");
    myTrie.insert("generator");


    cout << "Searching for 'google': " << (myTrie.search("google") ? "Found!"  : "Not Found!") << endl;
    cout << "Searching for 'git': " << (myTrie.search("git") ? "Found!" : "Not Found!") << endl;


    cout << "Does any word start with 'gra'?: " << (myTrie.startsWith("gra") ? "Yes"   : "No") << endl;
    cout << "Does any word start with 'app'?: " << (myTrie.startsWith("app") ? "Yes" : "No") << endl;

    return 0;
}
